{
  "name": "ember",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "demo:offline": "npm run build && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "verify:replay": "node --experimental-strip-types scripts/verify-replay.ts",
    "verify:preview": "node --experimental-strip-types scripts/verify-uvc-preview.ts",
    "verify:palette": "node --experimental-strip-types scripts/verify-palette-cue.ts",
    "verify:offline": "npm run build && node --experimental-strip-types scripts/verify-offline-build.ts",
    "verify:hardening": "npm run verify:replay && npm run verify:preview && npm run verify:palette && npm run lint && npm run verify:offline"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
